  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "0.2.0",
      "title": "Contract",
      "type": "string"
    },
    "machine_id": {
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "title": "Machine Id",
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "boot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Boot Id",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "report_interval_seconds": {
      "maximum": 3600,
      "minimum": 10,
      "title": "Report Interval Seconds",
      "type": "integer"
    },
    "edge_build": {
      "title": "Edge Build",
      "type": "string"
    },
