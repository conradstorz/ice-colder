{
  "$defs": {
    "ChannelDescriptor": {
      "description": "One telemetry channel the monitor declares in its capabilities.",
      "properties": {
        "channel_id": {
          "description": "Slug; also the topic segment",
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Channel Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "temperature",
            "current",
            "voltage",
            "level",
            "binary",
            "counter"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "default": "",
          "description": "Unit, e.g. 'C', 'A', '%'; empty for binary",
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Human-readable channel description",
          "title": "Description",
          "type": "string"
        },
        "interval_seconds": {
          "description": "Declared publish cadence",
          "exclusiveMinimum": 0.0,
          "maximum": 3600.0,
          "title": "Interval Seconds",
          "type": "number"
        }
      },
      "required": [
        "channel_id",
        "kind",
        "interval_seconds"
      ],
      "title": "ChannelDescriptor",
      "type": "object"
    }
  },
  "description": "Retained self-description on capabilities/<subsystem>.\n\nPublished on connect and whenever any declared property changes. A\nretained document never means the subsystem is alive \u2014 only heartbeats\ndo \u2014 it means \"this is what that board is, if and when it is up\".",
  "properties": {
    "subsystem": {
      "pattern": "^[a-z0-9_]{1,32}$",
      "title": "Subsystem",
      "type": "string"
    },
    "firmware": {
      "description": "Software/firmware version string",
      "title": "Firmware",
      "type": "string"
    },
    "contract_version": {
      "description": "Contract semver implemented",
      "title": "Contract Version",
      "type": "string"
    },
    "brand": {
      "default": "",
      "description": "Hardware brand, if meaningful",
      "title": "Brand",
      "type": "string"
    },
    "model": {
      "default": "",
      "description": "Hardware model, if meaningful",
      "title": "Model",
      "type": "string"
    },
    "hardware_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "MAC or serial number",
      "title": "Hardware Id"
    },
    "ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "IPv4/IPv6 address on the LAN",
      "title": "Ip"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelDescriptor"
      },
      "title": "Channels",
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "title": "Commands",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "subsystem",
    "firmware",
    "contract_version"
  ],
  "title": "SubsystemCapabilities",
  "type": "object"
}
