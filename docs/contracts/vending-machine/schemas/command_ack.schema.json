{
  "description": "Subsystem -> VMC acknowledgement on `.../cmd/<subsystem>/ack`.\n\nEvery field present in the original ice-maker `CommandAck` is unchanged;\n`result` is the only addition (optional, default None), so a present-day\nack payload with no `result` key still validates.",
  "properties": {
    "request_id": {
      "description": "Echoed from the command",
      "title": "Request Id",
      "type": "string"
    },
    "command": {
      "title": "Command",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "rejected",
        "failed",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "result": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "command",
    "status"
  ],
  "title": "CommandAck",
  "type": "object"
}
