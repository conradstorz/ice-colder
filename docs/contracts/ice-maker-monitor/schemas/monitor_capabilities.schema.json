{
  "$defs": {
    "ChannelDescriptor": {
      "description": "One telemetry channel the monitor declares in its capabilities.",
      "properties": {
        "channel_id": {
          "description": "Slug; also the topic segment",
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Channel Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "temperature",
            "current",
            "voltage",
            "level",
            "binary",
            "counter"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "default": "",
          "description": "Unit, e.g. 'C', 'A', '%'; empty for binary",
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Human-readable channel description",
          "title": "Description",
          "type": "string"
        },
        "interval_seconds": {
          "description": "Declared publish cadence",
          "exclusiveMinimum": 0.0,
          "maximum": 3600.0,
          "title": "Interval Seconds",
          "type": "number"
        },
        "direction": {
          "default": "input",
          "description": "Output = something the board drives (motor, solenoid, relay, compressor). Input = something it senses.",
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "driven_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Command whose refusal by the VMC inhibits this signal",
          "title": "Driven By"
        }
      },
      "required": [
        "channel_id",
        "kind",
        "interval_seconds"
      ],
      "title": "ChannelDescriptor",
      "type": "object"
    }
  },
  "description": "Retained self-description published on connect and on channel changes.\n\nThe ice-maker contract fixes `subsystem` and requires brand/model; the\noptional `hardware_id`/`ip` are the 1.1.0 additions.",
  "properties": {
    "subsystem": {
      "const": "ice_maker",
      "default": "ice_maker",
      "title": "Subsystem",
      "type": "string"
    },
    "firmware": {
      "description": "Software/firmware version string",
      "title": "Firmware",
      "type": "string"
    },
    "contract_version": {
      "description": "Contract semver implemented",
      "title": "Contract Version",
      "type": "string"
    },
    "brand": {
      "description": "Ice maker brand the monitor targets",
      "title": "Brand",
      "type": "string"
    },
    "model": {
      "description": "Ice maker model",
      "title": "Model",
      "type": "string"
    },
    "hardware_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "MAC or serial number",
      "title": "Hardware Id"
    },
    "ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "IPv4/IPv6 address on the LAN",
      "title": "Ip"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelDescriptor"
      },
      "title": "Channels",
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "title": "Commands",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "firmware",
    "contract_version",
    "brand",
    "model"
  ],
  "title": "MonitorCapabilities",
  "type": "object"
}
