# Copy to .env (gitignored). Shared by the broker init, the VMC, the
# simulators and Home Assistant.
MQTT_USERNAME=vmc
MQTT_PASSWORD=change-me
# Optional second broker account for Home Assistant, so it does not share the
# VMC's credential. Leave HA_MQTT_PASSWORD empty and no such account is created;
# set it (12+ characters) and mosquitto-init adds it on every start.
HA_MQTT_USERNAME=homeassistant
HA_MQTT_PASSWORD=
# Host address the broker listens on. Use the LAN interface address so
# 1883 is never reachable through a stray port-forward or a second NIC.
# The example is loopback so a forgotten edit exposes nothing; Home Assistant
# and the e2e tests need the LAN address here.
MQTT_BIND_ADDR=127.0.0.1
# Docker network(s) Traefik reaches the VMC from; X-Forwarded-For is
# trusted only from these (comma-separated CIDRs).
ICE_COLDER_TRUSTED_PROXIES=

# --- Cloud fleet portal (docker/docker-compose.cloud.yml, packages/cloud/README.md) ---
# External base URL of the portal. Google redirects back to
# ${ICE_CLOUD_PUBLIC_URL}/auth/google/callback, so register exactly that URI.
# Required when the Google client below is set.
ICE_CLOUD_PUBLIC_URL=http://127.0.0.1:26124
# Google OAuth client (Cloud Console, "Web application"). Set both or neither;
# with neither, /login says sign-in is not configured but the machine API works.
ICE_CLOUD_GOOGLE_CLIENT_ID=
ICE_CLOUD_GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails of platform admins (the /admin page). Empty = none.
ICE_CLOUD_ADMINS=
# Cookie signing key, at least 32 bytes; the cloud refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Replace this placeholder before any real use.
ICE_CLOUD_SESSION_KEY=change-me-generate-with-secrets-token-urlsafe-48
# Set to 1 only for local development over plain http (drops the Secure cookie flag).
ICE_CLOUD_INSECURE_COOKIES=
