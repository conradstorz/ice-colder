# Copy to .env (gitignored). Shared by the broker init, the VMC, the
# simulators and Home Assistant.
MQTT_USERNAME=vmc
MQTT_PASSWORD=change-me
# Optional second broker account for Home Assistant, so it does not share the
# VMC's credential. Leave HA_MQTT_PASSWORD empty and no such account is created;
# set it (12+ characters) and mosquitto-init adds it on every start.
HA_MQTT_USERNAME=homeassistant
HA_MQTT_PASSWORD=
# Host address the broker listens on. Use the LAN interface address so
# 1883 is never reachable through a stray port-forward or a second NIC.
# The example is loopback so a forgotten edit exposes nothing; Home Assistant
# and the e2e tests need the LAN address here.
MQTT_BIND_ADDR=127.0.0.1
# Docker network(s) Traefik reaches the VMC from; X-Forwarded-For is
# trusted only from these (comma-separated CIDRs).
ICE_COLDER_TRUSTED_PROXIES=
