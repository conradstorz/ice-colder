CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# The console is the S3 DevKitC's native USB port (USB Serial/JTAG, VID 303A), where the flash tool
# looks for the board; UART0 stays free of the console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=600000
CONFIG_MQTT_REPORT_DELETED_MESSAGES=y
# Second layer only: lets a long flash erase be suspended for the other core. The quiet window
# (src/flash_window.h) is the actual fix for NVS work freezing the bus task.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
